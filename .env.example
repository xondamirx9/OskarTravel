# ── Обязательное для генерации текстов агентом (иначе — шаблонный fallback) ──
# Ключ Claude API: https://platform.claude.com
ANTHROPIC_API_KEY=
# Модель (по умолчанию claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# ── Telegram (docs/setup-telegram.md) ──
# Токен бота от @BotFather; бот должен быть админом канала с правом публикации
TELEGRAM_BOT_TOKEN=
# @username публичного канала или -100... для приватного
TELEGRAM_CHANNEL_ID=@oskartravel

# ── Instagram Graph API (docs/setup-instagram.md) ──
# Долгоживущий токен (~60 дней, требует обновления)
IG_ACCESS_TOKEN=
# ID бизнес-аккаунта Instagram (число 1784...)
IG_BUSINESS_ACCOUNT_ID=

# ── Публичный URL платформы (обязателен для публикации в Instagram:
#    Graph API скачивает медиа по публичным HTTPS-ссылкам) ──
PUBLIC_BASE_URL=

# ── Прочее ──
# Порт сервера
PORT=3000
# Путь к Chromium для рендера обложек (по умолчанию берётся системный Playwright-браузер)
# CHROMIUM_PATH=/opt/pw-browsers/chromium
